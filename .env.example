# Public browser configuration for the same Supabase project as the Mac app.
# Replace both placeholders before running/building the application.
# Never put service-role, OpenAI, or other privileged keys in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional PostHog product analytics, replay and heatmaps (EU cloud).
VITE_POSTHOG_KEY=phc_YOUR_PUBLIC_PROJECT_TOKEN
VITE_POSTHOG_HOST=https://YOUR_POSTHOG_HOST

# Browser push: the VAPID public key (npm run push:keys). Optional; without it only email reminders are offered.
VITE_VAPID_PUBLIC_KEY=
