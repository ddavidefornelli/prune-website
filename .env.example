# Public browser configuration for the prune Supabase project.
# Replace both placeholders before running/building the application.
# Never put service-role or other privileged keys in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional PostHog product analytics, replay and heatmaps (EU cloud), loaded
# only after a visitor accepts optional cookies.
VITE_POSTHOG_KEY=phc_YOUR_PUBLIC_PROJECT_TOKEN

# Web Push (daily come-back notifications): the VAPID public key. Its private
# half is the daily-reminders function's VAPID_PRIVATE_KEY; never replace the
# pair, or every subscription stops. Without it, prune never asks.
VITE_VAPID_PUBLIC_KEY=
